# Docker 专用环境变量
# docker compose 会自动加载此文件

# 模型根目录（容器内路径）
MODEL_ROOT=/models

# 模型子目录
EMBEDDING_MODEL_DIR=bge-m3
RERANKER_MODEL_DIR=bge-reranker-v2-m3
LLM_GGUF_DIR=Qwen2.5-3B-Instruct-GGUF/qwen2.5-3b-instruct-q4_k_m.gguf

# llama-server 地址（Docker 服务名）
LLAMA_SERVER_URL=http://llama-server:8080/v1/completions

# CPU 模式
DEVICE=cpu

# 检索参数
TOP_K_RETRIEVAL=8
TOP_K_FINAL=4
SIMILARITY_THRESHOLD=0.20
